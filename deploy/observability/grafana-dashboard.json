      "id": 2,
      "title": "Latência de Conversão - Percentil 95 (s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(fileconvert_conversion_duration_seconds_bucket[5m])) by (le, source_format, target_format))",
          "legendFormat": "p95 {{source_format}} -> {{target_format}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
