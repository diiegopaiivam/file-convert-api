FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/worker ./cmd/worker

FROM debian:bookworm-slim

# Fixacao estrita de versoes de binarios nativos de conversao (Debian Bookworm)
# NUNCA utilizar 'latest' ou pacotes sem trava de versao para garantir reprodutibilidade e seguranca.
ENV FFMPEG_VERSION="7:5.1.*" \
    LIBREOFFICE_VERSION="4:7.4.*" \
    IMAGEMAGICK_VERSION="8:6.9.*" \
    POPPLER_VERSION="22.12.*"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg="${FFMPEG_VERSION}" \
    libreoffice-writer="${LIBREOFFICE_VERSION}" \
    imagemagick="${IMAGEMAGICK_VERSION}" \
    poppler-utils="${POPPLER_VERSION}" \
    ca-certificates \
 && sed -i 's/<policy domain="coder" rights="none" pattern="PDF" \/>/<policy domain="coder" rights="read|write" pattern="PDF" \/>/g' /etc/ImageMagick-6/policy.xml \
 && rm -rf /var/lib/apt/lists/*

RUN useradd -m appuser && \
    mkdir -p /data/storage && \
    chown -R appuser:appuser /data/storage
COPY --from=build /out/worker /usr/local/bin/worker
USER appuser
ENTRYPOINT ["/usr/local/bin/worker"]
